<%@ Master Language="C#" %>

<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <title>Fixer</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <form id="form1" runat="server">

  <nav class="navbar navbar-expand bg-white shadow-sm py-3">
    <div class="container">

        <a class="navbar-brand fw-bold text-primary fs-3" href="Default.aspx">Fixer</a>

        <ul class="navbar-nav mx-auto">
            <li class="nav-item"><a class="nav-link fw-semibold" href="Default.aspx#que-es">¿Qué es Fixer?</a></li>
            <li class="nav-item"><a class="nav-link fw-semibold" href="Default.aspx#servicios">Servicios</a></li>
            <li class="nav-item"><a class="nav-link fw-semibold" href="Default.aspx#sumate">Sumate como fixer</a></li>
        </ul>

      <% if (Session["Usuario"] == null) { %>

    <a href="Login.aspx" class="btn btn-primary rounded-pill px-4">Iniciar sesión</a>

<% } else { %>

    <span class="fw-semibold me-3">Hola, <%: ((Dominio.Usuario)Session["Usuario"]).Nombre %></span>
    <a href="Logout.aspx" class="btn btn-outline-primary rounded-pill px-4">Cerrar sesión</a>

<% } %>

    </div>
</nav>

        <asp:ContentPlaceHolder ID="MainContent" runat="server">
        </asp:ContentPlaceHolder>
   <footer class="bg-white border-top py-4">
    <div class="container">
        <div class="row align-items-center">
            <div class="col">
                <p class="fw-bold text-primary fs-4 mb-1">Fixer</p>
                <p class="fw-semibold mb-1">Trabajo Práctico Integrador · Base de Datos II</p>
                <p class="text-secondary mb-0">Universidad Tecnológica Nacional · Facultad Regional General Pacheco</p>
            </div>
            <div class="col text-end">
                <p class="fw-semibold mb-1">Creado por</p>
                <p class="text-secondary mb-0">Mateo Herrera y Walter Lugo</p>
            </div>
        </div>
        <hr class="my-3" />
        <p class="text-center text-secondary small mb-0">© 2026 Fixer</p>
    </div>
</footer>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>